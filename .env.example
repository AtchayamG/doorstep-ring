# Ring Partner API / Developers Playground OAuth Token (valid for 30 minutes)
# Obtain from: https://developer.amazon.com/ring/console/playground
RING_ACCESS_TOKEN=

# AWS Configuration (default uses ~/.aws/credentials and us-east-1)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Service Port
PORT=3002
